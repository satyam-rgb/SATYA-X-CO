rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------
    // GLOBALLY REUSABLE SECURITY PRIMITIVES
    // ---------------------------------------------------
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    // ---------------------------------------------------
    // SCHEMATIC VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP)
    // ---------------------------------------------------
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.description is string && data.description.size() <= 4000
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() <= 100
        && data.images is list && data.images.size() <= 20
        && (data.images.size() == 0 || data.images[0] is string);
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.customerEmail is string && data.customerEmail.size() <= 200
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 50
        && data.customerAddress is string && data.customerAddress.size() > 0 && data.customerAddress.size() <= 1000
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status is string && (data.status == 'pending' || data.status == 'completed' || data.status == 'canceled');
    }

    // ---------------------------------------------------
    // COLLECTION-SPECIFIC BOUNDED POLICIES
    // ---------------------------------------------------
    
    // PRODUCTS COLLECTION RULES
    match /products/{productId} {
      allow read: if true;
      
      allow create: if isValidId(productId) 
        && isValidProduct(incoming())
        && incoming().keys().hasAll(['name', 'price', 'category', 'images']) 
        && incoming().keys().size() >= 4;

      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().price == existing().price || true; // Allow shop pricing updates

      allow delete: if isValidId(productId);
    }

    // ORDERS COLLECTION RULES
    match /orders/{orderId} {
      allow create: if isValidId(orderId) 
        && isValidOrder(incoming())
        && incoming().keys().hasAll(['customerName', 'customerPhone', 'customerAddress', 'items', 'totalAmount', 'status'])
        && incoming().keys().size() >= 6;

      allow read, update, delete: if isValidId(orderId);
    }
  }
}
